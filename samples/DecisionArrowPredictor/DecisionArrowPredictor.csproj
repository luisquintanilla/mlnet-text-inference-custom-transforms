<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Directory.Build.props has already evaluated; this consumer never runs ONNX. -->
    <PackageReference Remove="Microsoft.ML.OnnxRuntime;Microsoft.ML.OnnxRuntime.Gpu" />
    <PackageReference Include="Microsoft.ML" Version="[5.0.0]" />
    <PackageReference Include="DecisionInference.Arrow" Version="[0.1.0-exp.decisions.1.gab4eebf29b9f]" />
    <PackageReference Include="Apache.Arrow" Version="[23.0.0-exp.decisions.1.g6aafc634d65c]" />
    <None Update="questions.v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
